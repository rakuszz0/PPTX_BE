APP_ENV=development
# PostgreSQL URL. For Docker Compose, use localhost; from another Compose
# service, replace localhost with postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/blablabla
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
MAX_CONCURRENCY=2
MIN_QA_SCORE=85
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OAuth 2.0 — Login Sosial (opsional; kosongkan = tombol disabled)
#
# Callback URL untuk setiap provider (dibaca oleh backend sebagai redirect_uri):
#   http://localhost:8000/api/v1/auth/oauth/callback/google
#   http://localhost:8000/api/v1/auth/oauth/callback/github
#   http://localhost:8000/api/v1/auth/oauth/callback/facebook
#   http://localhost:8000/api/v1/auth/oauth/callback/yahoo
#
# Daftarkan OAuth app di masing-masing konsol developer, lalu isi client_id
# dan client_secret di bawah ini. Setelah itu restart backend.
# ---------------------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Authorized redirect URIs: /api/v1/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Developer settings → OAuth Apps
#   Homepage URL     : http://localhost:3000
#   Authorization callback URL: /api/v1/auth/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook for Developers → My Apps → Add product → Facebook Login
#   Valid OAuth Redirect URIs: /api/v1/auth/oauth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Yahoo Developer → Apps → Create an App
#   Callback Domain / Redirect URI: /api/v1/auth/oauth/callback/yahoo
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# URL halaman frontend tempat user dikembalikan setelah OAuth selesai
# (sukses = ?oauth=success, gagal = ?oauth_error=...)
OAUTH_REDIRECT_FRONTEND=http://localhost:3000/profile
