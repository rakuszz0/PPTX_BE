APP_ENV=development
# PostgreSQL URL. For Docker Compose, use localhost; from another Compose
# service, replace localhost with postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/blablabla
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
MAX_CONCURRENCY=2
MIN_QA_SCORE=85
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
